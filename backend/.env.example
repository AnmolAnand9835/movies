# CineAtlas Backend Environment Configuration
# To get a TMDB API Read Access Token, register at https://www.themoviedb.org/settings/api

PORT=5000
NODE_ENV=development
TMDB_API_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here
FRONTEND_URL=http://localhost:5173

# Optional deployment origins to allow for preview and branch deployments.
# FRONTEND_URL_DEVELOPMENT=http://localhost:5173
# FRONTEND_URL_BRANCH=https://your-branch--app.netlify.app
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-app.netlify.app

# Optional: Redis configuration for production caching
# REDIS_URL=redis://localhost:6379
# CACHE_TTL_TRENDING=600
# CACHE_TTL_POPULAR=900
# CACHE_TTL_GENRES=86400
# CACHE_TTL_DETAILS=1800
# CACHE_TTL_SEARCH=300